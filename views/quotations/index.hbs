<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Quotation Management</h2>
            <p class="text-muted">Manage quotations from suppliers.</p>
        </div>

        <a href="/quotations/add"
           hx-get="/quotations/add"
           hx-target="#main"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>
            Create Quotation
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">Quotation List</h5>

            <form hx-get="/quotations/"
                  hx-target="#main"
                  hx-swap="innerHTML"
                  class="row g-3 mb-4">
                <div class="col-md-9">
                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Search by Quotation ID, RFQ ID, or Supplier..."
                           value="{{search}}">
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-2"></i>Search
                    </button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Quotation ID</th>
                            <th>RFQ ID</th>
                            <th>Supplier</th>
                            <th>Delivery Terms</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each quotations}}
                        <tr>
                            <td class="fw-semibold">{{quotation_id}}</td>
                            <td>{{rfq_id}}</td>
                            <td>
                                {{supplier_name}}
                                <div class="small text-muted">{{supplier_id}}</div>
                            </td>
                            <td>{{delivery_terms}}</td>
                            <td>
                                <span class="badge bg-secondary">{{status}}</span>
                            </td>
                            <td>{{created_at}}</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a href="/quotations/edit/{{quotation_id}}"
                                       hx-get="/quotations/edit/{{quotation_id}}"
                                       hx-target="#main"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil-square me-1"></i>Edit
                                    </a>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            hx-delete="/quotations/delete/{{quotation_id}}"
                                            hx-target="#main"
                                            hx-swap="innerHTML"
                                            hx-confirm="Are you sure you want to delete Quotation {{quotation_id}}?">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No quotations found.
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>