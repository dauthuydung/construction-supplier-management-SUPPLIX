<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Edit Quotation</h2>
            <p class="text-muted">Update quotation information.</p>
        </div>
        <a href="/quotations/"
           hx-get="/quotations/"
           hx-target="#main"
           class="btn btn-outline-secondary">
            Back to Quotation List
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form hx-post="/quotations/edit/{{quotation.quotation_id}}"
                  hx-target="#main"
                  hx-swap="innerHTML">

                <h5 class="fw-bold mb-4">Quotation Information</h5>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Quotation ID</label>
                    <input type="text" class="form-control"
                           value="{{quotation.quotation_id}}" readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">RFQ ID</label>
                    <input type="text" class="form-control"
                           value="{{quotation.rfq_id}}" readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Supplier ID</label>
                    <input type="text" class="form-control"
                           value="{{quotation.supplier_id}}" readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Delivery Terms</label>
                    <textarea name="delivery_terms" class="form-control"
                              rows="3">{{quotation.delivery_terms}}</textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Status</label>
                    <select name="status" class="form-select" required>
                        <option value="pending"  {{#if quotation.statusPending}}selected{{/if}}>Pending</option>
                        <option value="accepted" {{#if quotation.statusAccepted}}selected{{/if}}>Accepted</option>
                        <option value="rejected" {{#if quotation.statusRejected}}selected{{/if}}>Rejected</option>
                    </select>
                </div>

                <hr class="my-4">

                <h5 class="fw-bold mb-2">Quotation Items</h5>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Material</th>
                                <th>Unit Price</th>
                                <th>Quantity</th>
                                <th>Delivery Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each items}}
                            <tr>
                                <td>
                                    {{material_name}} ({{material_unit}})
                                    <input type="hidden" name="quotation_item_id[]"
                                           value="{{quotation_item_id}}">
                                </td>
                                <td>
                                    <input type="number" name="unit_price[]"
                                           class="form-control" min="0.01" step="0.0001"
                                           value="{{unit_price}}" required>
                                </td>
                                <td>
                                    <input type="number" name="quantity[]"
                                           class="form-control" min="0.01" step="0.0001"
                                           value="{{quantity}}" required>
                                </td>
                                <td>
                                    <input type="date" name="delivery_date[]"
                                           class="form-control"
                                           value="{{delivery_date}}" required>
                                </td>
                            </tr>
                            {{else}}
                            <tr>
                                <td colspan="4" class="text-center text-muted">
                                    No items found.
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>

                <hr class="my-4">

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-2"></i>Save Changes
                    </button>
                    <a href="/quotations/"
                       hx-get="/quotations/"
                       hx-target="#main"
                       class="btn btn-outline-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>
</div>