
<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Create RFQ</h2>
            <p class="text-muted">
                Create a new request for quotation.
            </p>
        </div>

        <a href="/rfqs/"
           hx-get="/rfqs/"
           hx-target="#main"
           class="btn btn-outline-secondary">
            Back to RFQ List
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form hx-post="/rfqs/add"
                  hx-target="#main"
                  hx-swap="innerHTML">

                <!-- RFQ INFORMATION -->

                <h5 class="fw-bold mb-4">RFQ Information</h5>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        RFQ ID
                    </label>
                    <input type="text"
                           name="rfq_id"
                           class="form-control"
                           maxlength="20"
                           placeholder="Example: RFQ_002"
                           required>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Project
                    </label>
                    <select name="project_id"
                            class="form-select"
                            required>
                        <option value="">Select Project</option>
                        {{#each projects}}
                        <option value="{{project_id}}">
                            {{name}} ({{project_id}})
                        </option>
                        {{/each}}
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Created By
                    </label>
                    <select name="created_by"
                            class="form-select"
                            required>
                        <option value="">Select User</option>
                        {{#each users}}
                        <option value="{{user_id}}">
                            {{name}} ({{user_id}})
                        </option>
                        {{/each}}
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Deadline
                    </label>
                    <input type="date"
                           name="deadline"
                           class="form-control"
                           required>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        Status
                    </label>
                    <select name="status"
                            class="form-select"
                            required>
                        <option value="draft">Draft</option>
                        <option value="open">Open</option>
                        <option value="closed">Closed</option>
                    </select>
                </div>

                <hr class="my-4">

                <!-- RFQ MATERIALS -->

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">RFQ Materials</h5>
                        <p class="text-muted mb-0">
                            Select materials and specify required quantities.
                        </p>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 45%;">Material</th>
                                <th style="width: 20%;">Quantity</th>
                                <th style="width: 25%;">Required Date</th>
                                <th style="width: 10%;">Action</th>
                            </tr>
                        </thead>

                        <tbody id="rfq-material-rows">

                            <tr class="rfq-material-row">
                                <td>
                                    <select name="material_id[]"
                                            class="form-select"
                                            required>
                                        <option value="">
                                            Select Material
                                        </option>

                                        {{#each materials}}
                                        <option value="{{material_id}}">
                                            {{name}} ({{unit}})
                                        </option>
                                        {{/each}}
                                    </select>
                                </td>

                                <td>
                                    <input type="number"
                                           name="quantity[]"
                                           class="form-control"
                                           min="0.0001"
                                           step="0.0001"
                                           placeholder="Quantity"
                                           required>
                                </td>

                                <td>
                                    <input type="date"
                                           name="required_date[]"
                                           class="form-control">
                                </td>

                                <td class="text-center">
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm"
                                            onclick="removeRFQMaterial(this)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>

                <button type="button"
                        class="btn btn-outline-primary mb-4"
                        onclick="addRFQMaterial()">
                    <i class="bi bi-plus-circle me-2"></i>
                    Add Material
                </button>

                <hr class="my-4">

                <!-- SUBMIT -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-check-circle me-2"></i>
                        Create RFQ
                    </button>

                    <a href="/rfqs/"
                       hx-get="/rfqs/"
                       hx-target="#main"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>
        </div>
    </div>
</div>

<!-- Material row template -->
<template id="rfq-material-template">
    <tr class="rfq-material-row">
        <td>
            <select name="material_id[]"
                    class="form-select"
                    required>
                <option value="">Select Material</option>
                {{#each materials}}
                <option value="{{material_id}}">
                    {{name}} ({{unit}})
                </option>
                {{/each}}
            </select>
        </td>

        <td>
            <input type="number"
                   name="quantity[]"
                   class="form-control"
                   min="0.0001"
                   step="0.0001"
                   placeholder="Quantity"
                   required>
        </td>

        <td>
            <input type="date"
                   name="required_date[]"
                   class="form-control">
        </td>

        <td class="text-center">
            <button type="button"
                    class="btn btn-outline-danger btn-sm"
                    onclick="removeRFQMaterial(this)">
                <i class="bi bi-trash"></i>
            </button>
        </td>
    </tr>
</template>

<script>
    // Register functions globally because HTMX swaps page fragments.
    window.addRFQMaterial = function () {
        const tbody = document.getElementById('rfq-material-rows');
        const template = document.getElementById('rfq-material-template');

        if (!tbody || !template) return;

        tbody.appendChild(template.content.cloneNode(true));
    };

    window.removeRFQMaterial = function (button) {
        const tbody = document.getElementById('rfq-material-rows');

        if (!tbody) return;

        const rows = tbody.querySelectorAll('.rfq-material-row');

        if (rows.length <= 1) {
            alert('An RFQ must contain at least one material.');
            return;
        }

        button.closest('tr').remove();
    };
</script>
