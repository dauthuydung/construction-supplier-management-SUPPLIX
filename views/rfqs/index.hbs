<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">RFQ Management</h2>
            <p class="text-muted">
                Manage requests for quotation for construction projects.
            </p>
        </div>

        <a href="/rfqs/add"
           hx-get="/rfqs/add"
           hx-target="#main"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>
            Create RFQ
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">RFQ List</h5>

            <!-- RFQ SEARCH -->
            <form hx-get="/rfqs/"
                  hx-target="#main"
                  hx-swap="innerHTML"
                  class="row g-3 mb-4">

                <div class="col-md-9">
                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Search by RFQ ID or Project..."
                           value="{{search}}">
                </div>

                <div class="col-md-3">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        <i class="bi bi-search me-2"></i>
                        Search RFQ
                    </button>
                </div>
            </form>

            <!-- RFQ TABLE -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>RFQ ID</th>
                            <th>Project</th>
                            <th>Created By</th>
                            <th>Deadline</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        {{#each rfqs}}
                        <tr>
                            <td class="fw-semibold">
                                {{rfq_id}}
                            </td>

                            <td>
                                {{project_name}}
                                <div class="small text-muted">
                                    {{project_id}}
                                </div>
                            </td>

                            <td>
                                {{created_by_name}}
                            </td>

                            <td>{{deadline}}</td>

                            <td>
                                <span class="badge bg-secondary">
                                    {{status}}
                                </span>
                            </td>

                            <td>{{created_at}}</td>

                            <td>
                                <div class="d-flex gap-2">

                                    <!-- EDIT RFQ -->
                                    <a href="/rfqs/edit/{{rfq_id}}"
                                       hx-get="/rfqs/edit/{{rfq_id}}"
                                       hx-target="#main"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil-square me-1"></i>
                                        Edit
                                    </a>

                                    <!-- DELETE RFQ -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            hx-delete="/rfqs/delete/{{rfq_id}}"
                                            hx-target="#main"
                                            hx-swap="innerHTML"
                                            hx-confirm="Are you sure you want to delete RFQ {{rfq_id}}? This action cannot be undone.">
                                        <i class="bi bi-trash me-1"></i>
                                        Delete
                                    </button>

                                </div>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-4">
                                No RFQs found.
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>