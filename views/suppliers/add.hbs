
<div class="container-fluid py-3">

    <div class="mb-4">
        <h2 class="fw-bold">Add New Supplier</h2>
        <p class="text-muted">
            Enter the information of a construction material supplier.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form action="/suppliers/add" method="POST"
                  hx-boost="false">

                <div class="mb-3">
                    <label class="form-label">Company Name *</label>
                    <input type="text"
                           name="company_name"
                           class="form-control"
                           maxlength="200"
                           required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea name="description"
                              class="form-control"
                              rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Location</label>
                    <input type="text"
                           name="location"
                           class="form-control">
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text"
                               name="phone"
                               class="form-control"
                               maxlength="100">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email</label>
                        <input type="email"
                               name="email"
                               class="form-control"
                               maxlength="200">
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-check-circle"></i>
                        Save Supplier
                    </button>

                    <a href="/suppliers"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>