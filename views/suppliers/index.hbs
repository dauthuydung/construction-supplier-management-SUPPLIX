
<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Supplier Management</h2>
            <p class="text-muted">
                View and manage construction material suppliers.
            </p>
        </div>
            <a href="/suppliers/add"
       class="btn btn-primary"
       hx-boost="false">
        <i class="bi bi-plus-circle"></i>
        Add Supplier
    </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">Supplier List</h5>

<form action="/suppliers" method="GET"
      hx-boost="false"
      class="d-flex gap-2 mb-4">

    <input type="text"
           name="search"
           class="form-control"
           placeholder="Search suppliers by company name..."
           value="{{search}}">

    <button type="submit" class="btn btn-primary">
        <i class="bi bi-search"></i>
        Search
    </button>

    <a href="/suppliers"
       hx-boost="false"
       class="btn btn-outline-secondary">
        Clear
    </a>

</form>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Supplier ID</th>
                            <th>Company Name</th>
                            <th>Location</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        {{#each suppliers}}
                        <tr>
                            <td>{{supplier_id}}</td>
                            <td class="fw-semibold">
                                {{company_name}}
                            </td>
                            <td>{{location}}</td>
                            <td>{{phone}}</td>
                            <td>{{email}}</td>
                            <td>
                                {{#if is_verified}}
                                    <span class="badge bg-success">
                                        Verified
                                    </span>
                                {{else}}
                                    <span class="badge bg-secondary">
                                        Not Verified
                                    </span>
                                {{/if}}
                            </td>


<td>
    <div class="d-flex gap-2">

        <a href="/suppliers/edit/{{supplier_id}}"
           hx-boost="false"
           class="btn btn-sm btn-outline-primary">
            <i class="bi bi-pencil-square"></i>
            Edit
        </a>

        <form action="/suppliers/delete/{{supplier_id}}"
              method="POST"
              hx-boost="false"
              onsubmit="return confirm('Are you sure you want to delete this supplier?');">

            <button type="submit"
                    class="btn btn-sm btn-outline-danger">
                <i class="bi bi-trash"></i>
                Delete
            </button>

        </form>

    </div>
</td>

                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                No suppliers found.
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>