<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Purchase Order Management</h2>
            <p class="text-muted">Manage purchase orders for construction projects.</p>
        </div>

        <a href="/purchase_orders/add"
           hx-get="/purchase_orders/add"
           hx-target="#main"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>
            Create Purchase Order
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">Purchase Order List</h5>

            <form hx-get="/purchase_orders/"
                  hx-target="#main"
                  hx-swap="innerHTML"
                  class="row g-3 mb-4">

                <div class="col-md-9">
                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Search by PO ID, Project, or Supplier..."
                           value="{{search}}">
                </div>

                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-2"></i>
                        Search
                    </button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>PO ID</th>
                            <th>Project</th>
                            <th>Supplier</th>
                            <th>Quotation ID</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th>Transaction Date</th>
                            <th>Created At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        {{#each purchase_orders}}
                        <tr>
                            <td class="fw-semibold">{{po_id}}</td>
                            <td>
                                {{project_name}}
                                <div class="small text-muted">{{project_id}}</div>
                            </td>
                            <td>
                                {{supplier_name}}
                                <div class="small text-muted">{{supplier_id}}</div>
                            </td>
                            <td>{{quotation_id}}</td>
                            <td>{{total_amount}}</td>
                            <td>
                                <span class="badge bg-secondary">{{status}}</span>
                            </td>
                            <td>{{transaction_date}}</td>
                            <td>{{created_at}}</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a href="/purchase_orders/edit/{{po_id}}"
                                       hx-get="/purchase_orders/edit/{{po_id}}"
                                       hx-target="#main"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil-square me-1"></i>
                                        Edit
                                    </a>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            hx-delete="/purchase_orders/delete/{{po_id}}"
                                            hx-target="#main"
                                            hx-swap="innerHTML"
                                            hx-confirm="Are you sure you want to delete PO {{po_id}}?">
                                        <i class="bi bi-trash me-1"></i>
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                No purchase orders found.
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>