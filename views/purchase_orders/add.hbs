<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Create Purchase Order</h2>
            <p class="text-muted">Create a new purchase order from an accepted quotation.</p>
        </div>
        <a href="/purchase_orders/"
           hx-get="/purchase_orders/"
           hx-target="#main"
           class="btn btn-outline-secondary">
            Back to Purchase Order List
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form hx-post="/purchase_orders/add"
                  hx-target="#main"
                  hx-swap="innerHTML">

                <h5 class="fw-bold mb-4">Purchase Order Information</h5>

                <div class="mb-3">
                    <label class="form-label fw-semibold">PO ID</label>
                    <input type="text" name="po_id" class="form-control"
                           maxlength="20" placeholder="Example: PO_001" required>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Accepted Quotation</label>
                    <select name="quotation_id" class="form-select" required>
                        <option value="">Select Quotation</option>
                        {{#each quotations}}
                        <option value="{{quotation_id}}">
                            {{quotation_id}} — RFQ: {{rfq_id}} — {{company_name}} ({{supplier_id}})
                        </option>
                        {{/each}}
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Created By</label>
                    <select name="created_by" class="form-select" required>
                        <option value="">Select User</option>
                        {{#each users}}
                        <option value="{{user_id}}">{{name}} ({{user_id}})</option>
                        {{/each}}
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Status</label>
                    <select name="status" class="form-select" required>
                        <option value="draft">Draft</option>
                        <option value="pending">Pending</option>
                        <option value="accepted">Accepted</option>
                        <option value="rejected">Rejected</option>
                        <option value="in_progress">In Progress</option>
                        <option value="fulfilled">Fulfilled</option>
                    </select>
                </div>

                <hr class="my-4">

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-2"></i>Create Purchase Order
                    </button>
                    <a href="/purchase_orders/"
                       hx-get="/purchase_orders/"
                       hx-target="#main"
                       class="btn btn-outline-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>
</div>