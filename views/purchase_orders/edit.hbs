<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Edit Purchase Order</h2>
            <p class="text-muted">Update purchase order status.</p>
        </div>
        <a href="/purchase_orders/"
           hx-get="/purchase_orders/"
           hx-target="#main"
           class="btn btn-outline-secondary">
            Back to Purchase Order List
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form hx-post="/purchase_orders/edit/{{po.po_id}}"
                  hx-target="#main"
                  hx-swap="innerHTML">

                <h5 class="fw-bold mb-4">Purchase Order Information</h5>

                <div class="mb-3">
                    <label class="form-label fw-semibold">PO ID</label>
                    <input type="text" class="form-control" value="{{po.po_id}}" readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Quotation ID</label>
                    <input type="text" class="form-control" value="{{po.quotation_id}}" readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Created By</label>
                    <input type="text" class="form-control" value="{{po.created_by}}" readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Created At</label>
                    <input type="text" class="form-control" value="{{po.created_at}}" readonly>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Status</label>
                    <select name="status" class="form-select" required>
                        <option value="draft"       {{#if po.statusDraft}}selected{{/if}}>Draft</option>
                        <option value="pending"     {{#if po.statusPending}}selected{{/if}}>Pending</option>
                        <option value="accepted"    {{#if po.statusAccepted}}selected{{/if}}>Accepted</option>
                        <option value="rejected"    {{#if po.statusRejected}}selected{{/if}}>Rejected</option>
                        <option value="in_progress" {{#if po.statusInProgress}}selected{{/if}}>In Progress</option>
                        <option value="fulfilled"   {{#if po.statusFulfilled}}selected{{/if}}>Fulfilled</option>
                    </select>
                </div>

                {{#if poItems.length}}
                <hr class="my-4">
                <h5 class="fw-bold mb-2">PO Items</h5>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Material</th>
                                <th>Quantity</th>
                                <th>Agreed Unit Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each poItems}}
                            <tr>
                                <td>{{material_name}} ({{material_unit}})</td>
                                <td>{{quantity}}</td>
                                <td>{{agreed_unit_price}}</td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
                {{/if}}

                <hr class="my-4">

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-2"></i>Save Changes
                    </button>
                    <a href="/purchase_orders/"
                       hx-get="/purchase_orders/"
                       hx-target="#main"
                       class="btn btn-outline-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>
</div>