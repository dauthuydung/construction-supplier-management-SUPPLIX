
<div class="container-fluid py-3">


<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold">Material Management</h2>
        <p class="text-muted">
            View and manage construction materials.
        </p>
    </div>

    <a href="/materials/add"
       hx-get="/materials/add"
       hx-target="#main"
       class="btn btn-primary">

        <i class="bi bi-plus-circle me-2"></i>
        Add Material

    </a>

</div>


    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">Material List</h5>

<!-- MATERIAL SEARCH -->
<form
    hx-get="/materials/"
    hx-target="#main"
    hx-swap="innerHTML"
    class="row g-3 mb-4">

    <div class="col-md-9">
        <input
            type="text"
            name="search"
            class="form-control"
            placeholder="Search by Material ID or Material Name..."
            value="{{search}}">
    </div>

    <div class="col-md-3">
        <button
            type="submit"
            class="btn btn-primary w-100">

            <i class="bi bi-search me-2"></i>
            Search Material

        </button>
    </div>

</form>


            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Material ID</th>
                            <th>Material Name</th>
                            <th>Category</th>
                            <th>Unit</th>
                            <th>Specification</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        {{#each materials}}
                        <tr>
                            <td>{{material_id}}</td>
                            <td class="fw-semibold">{{name}}</td>
                            <td>{{category}}</td>
                            <td>{{unit}}</td>
                            <td>{{specification}}</td>


<td>
    <div class="d-flex gap-2">

        <!-- EDIT MATERIAL -->
        <a href="/materials/edit/{{material_id}}"
           hx-get="/materials/edit/{{material_id}}"
           hx-target="#main"
           class="btn btn-sm btn-outline-primary">

            <i class="bi bi-pencil-square me-1"></i>
            Edit
        </a>

        <!-- DELETE MATERIAL -->
        <button type="button"
                class="btn btn-sm btn-outline-danger"
                hx-post="/materials/delete/{{material_id}}"
                hx-confirm="Are you sure you want to delete this material?"
                hx-target="#main">

            <i class="bi bi-trash me-1"></i>
            Delete
        </button>

    </div>
</td>

                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                No materials found.
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
